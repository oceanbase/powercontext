# Copy this file to .env, replace the provider values, then load it with:
# set -a; . ./.env; set +a

POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_STORAGE_PATH=.powercontext/powercontext.db
POWERCONTEXT_SERVER_STORAGE_VEC1_EXTENSION=.powercontext/vec1.so

# Use openai-chat for OpenAI-compatible Chat Completions endpoints.
POWERCONTEXT_SERVER_INFERENCE_GENERATION_MODEL=openai-chat:your-chat-model
POWERCONTEXT_SERVER_INFERENCE_GENERATION_TIMEOUT_SECONDS=30
POWERCONTEXT_SERVER_INFERENCE_GENERATION_MAX_REQUESTS=2

# Embeddings use the OpenAI-compatible embeddings endpoint.
# Keep the profile ID stable for one model, dimension, and normalization tuple.
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_MODEL=openai:your-embedding-model
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_PROFILE_ID=your-embedding-model-1536
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_DIMENSION=1536
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_NORMALIZATION=none
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_TIMEOUT_SECONDS=30

OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1
OPENAI_API_KEY=replace-me

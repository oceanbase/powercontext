import { execFile } from 'node:child_process'
import type { ClientOptions } from './client.{{extension}}'

export interface ManagementReport extends Record<string, unknown> { ok: boolean; status: string; checks: Record<string, unknown> }

export function callManagement(config: ClientOptions, signal?: AbortSignal): Promise<ManagementReport> {
  return new Promise((resolve) => {
    const child = execFile('powercontext-hook', ['--doctor'], {
      signal, timeout: Math.max(config.requestTimeoutMs * 3, 10000) + 1000, maxBuffer: 1_048_576,
    }, (error, stdout) => {
      try {
        const report = JSON.parse(stdout) as ManagementReport
        if (typeof report.ok !== 'boolean' || !report.checks) throw new Error('Invalid diagnostic result')
        resolve(report)
      } catch {
        resolve({ ok: false, status: 'failed', checks: { client: { status: 'failed',
          detail: error ? 'PowerContext Python diagnostics are unavailable.' : 'Invalid diagnostic result',
        } } })
      }
    })
    child.stdin?.on('error', () => {})
    child.stdin?.end(JSON.stringify({
      connection: { base_url: config.baseUrl, authorization: config.authorization ?? null,
        allow_insecure_http: config.allowInsecureHttp ?? false, request_timeout: config.requestTimeoutMs / 1000 },
      deadline: (Date.now() + Math.max(config.requestTimeoutMs * 3, 10000)) / 1000,
    }) + '\n')
  })
}

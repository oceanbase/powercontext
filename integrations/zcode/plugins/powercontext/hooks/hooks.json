{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/user_prompt_submit.mjs"
            ],
            "timeoutMs": 5000,
            "statusMessage": "Syncing PowerContext"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session_start.mjs"
            ],
            "timeoutMs": 5000,
            "statusMessage": "Restoring PowerContext"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/stop.mjs"
            ],
            "timeoutMs": 1500,
            "statusMessage": "Processing PowerContext boundary"
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "powercontext-hook \"--script\" \"${PLUGIN_ROOT}/hooks/session_binding.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "powercontext-hook \"--script\" \"${PLUGIN_ROOT}/hooks/bind_tools.py\""
          }
        ],
        "matcher": "mcp__powercontext__.*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "powercontext-hook \"--script\" \"${PLUGIN_ROOT}/hooks/recall.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "powercontext-hook \"--script\" \"${PLUGIN_ROOT}/hooks/token_savings.py\""
          }
        ]
      }
    ]
  }
}

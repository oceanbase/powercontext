{
  "description": "Bootstrap scoped context, recall relevant memory, and capture the current Codex prompt.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"${PLUGIN_ROOT}\" python \"${PLUGIN_ROOT}/hooks/session_binding.py\"",
            "timeout": 10,
            "statusMessage": "Loading PowerContext context",
            "additionalContextLimit": 8192
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__powercontext__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"${PLUGIN_ROOT}\" python \"${PLUGIN_ROOT}/hooks/bind_tools.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"${PLUGIN_ROOT}\" python \"${PLUGIN_ROOT}/hooks/recall.py\"",
            "timeout": 10,
            "statusMessage": "Syncing PowerContext"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"${PLUGIN_ROOT}\" python \"${PLUGIN_ROOT}/hooks/token_savings.py\"",
            "timeout": 10,
            "statusMessage": "Loading PowerContext token savings"
          }
        ]
      }
    ]
  }
}

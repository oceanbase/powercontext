# PowerContext connection used inside the imported Dify workflow.
POWERCONTEXT_BASE_URL=http://host.docker.internal:8000
POWERCONTEXT_SCOPE_ID=replace-with-scope-id
POWERCONTEXT_TOKEN=replace-with-powercontext-token

# Optional: used only by scripts/verify_dify.py.
DIFY_BASE_URL=http://localhost
DIFY_API_KEY=app-replace-with-dify-api-key


[Unit]
Description=PowerContext evaluation console web service
After=network.target

[Service]
Type=simple
User=rongfeng.frf
Group=users
WorkingDirectory=/data/powercontext-eval/deploy/powercontext
EnvironmentFile=/data/powercontext-eval/config/evaluation-console.env
Environment=UV_CACHE_DIR=/data/powercontext-eval/cache/uv
ExecStart=/data/powercontext-eval/bin/uv run --project evaluation powercontext-eval web
KillMode=mixed
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyDirectories=/
ReadWriteDirectories=/data/powercontext-eval

[Install]
WantedBy=multi-user.target

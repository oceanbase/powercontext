# Copy this file to a mode-0600 location and replace every example value.
# It contains paths and local endpoints only. Never add credentials.
POWERCONTEXT_EVAL_ROOT=/srv/powercontext-eval
# The console has no built-in user authentication. Keep loopback unless an authenticating reverse proxy protects it.
POWERCONTEXT_EVAL_HOST=127.0.0.1
POWERCONTEXT_EVAL_PORT=8787
POWERCONTEXT_EVAL_DATABASE_PATH=/srv/powercontext-eval/web/tasks.sqlite3
POWERCONTEXT_EVAL_RUN_ROOT=/srv/powercontext-eval
POWERCONTEXT_EVAL_POWERCONTEXT_SOURCE=/srv/powercontext-eval/source/powercontext.git
POWERCONTEXT_EVAL_HARNESS_ROOT=/srv/powercontext-eval/cache/swebench-pro.git
POWERCONTEXT_EVAL_HARNESS_PYTHON=/srv/powercontext-eval/venvs/swebench-pro-ca10a60/bin/python
POWERCONTEXT_EVAL_DATASET_PATH=/srv/powercontext-eval/cache/swebench-pro.git/helper_code/sweap_eval_full_v2.jsonl
POWERCONTEXT_EVAL_CODEX_BINARY=/srv/powercontext-eval/bin/codex
POWERCONTEXT_EVAL_CODEX_MODELS=gpt-5.6-sol
# TokensFlow is an optional internal telemetry integration and is disabled by default.
POWERCONTEXT_EVAL_TOKENSFLOW_ENABLED=false
# When enabling it, set all three values below.
# POWERCONTEXT_EVAL_TOKENSFLOW_BINARY=/usr/local/bin/tokensflow
# POWERCONTEXT_EVAL_TOKENSFLOW_USER_HOME=/srv/powercontext-eval/tokensflow-home
# POWERCONTEXT_EVAL_TOKENSFLOW_EGRESS_NETWORK=bridge
POWERCONTEXT_EVAL_TOKENSFLOW_FINALIZER_TIMEOUT_SECONDS=600
POWERCONTEXT_EVAL_TOKENSFLOW_FINALIZER_POLL_SECONDS=5
POWERCONTEXT_EVAL_UV_BINARY=/srv/powercontext-eval/bin/uv
POWERCONTEXT_EVAL_REGISTRY_BINARY=/srv/powercontext-eval/bin/regctl
POWERCONTEXT_EVAL_AUTH_JSON=/srv/powercontext-eval/codex-home/auth.json
# Optional immutable Codex provider configuration copied into each isolated task home.
# POWERCONTEXT_EVAL_CODEX_CONFIG=/srv/powercontext-eval/codex-home/config.toml
# The evaluation proxy is disabled when this setting is absent. When enabled it must be a credential-free loopback URL.
# POWERCONTEXT_EVAL_PROXY_URL=http://127.0.0.1:8081
# Optional comma-separated bypass hosts; valid only when the evaluation proxy is enabled.
# POWERCONTEXT_EVAL_EXTRA_NO_PROXY_HOSTS=mirror.example.test
# Private IPv4 pool with at least 32 /28 subnets; change it if it overlaps host networks.
POWERCONTEXT_EVAL_DOCKER_NETWORK_POOL=172.30.0.0/15
POWERCONTEXT_EVAL_FRONTEND_DIST=/srv/powercontext-eval/deploy/powercontext/evaluation/web/dist
POWERCONTEXT_EVAL_LEASE_SECONDS=60
POWERCONTEXT_EVAL_POLL_SECONDS=1
POWERCONTEXT_EVAL_USAGE_PAUSE_PERCENT=80
POWERCONTEXT_EVAL_USAGE_MODE=subscription
POWERCONTEXT_EVAL_USAGE_PROBE_SECONDS=60
POWERCONTEXT_EVAL_USAGE_PROBE_TIMEOUT_SECONDS=15
POWERCONTEXT_EVAL_USAGE_SNAPSHOT_MAX_AGE_SECONDS=120
POWERCONTEXT_EVAL_TASK_PARALLELISM=1
POWERCONTEXT_EVAL_MAX_ATTEMPTS=5

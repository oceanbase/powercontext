# Copy to /data/powercontext-eval/config/evaluation-console.env and set mode 0600.
# This file contains paths and local endpoints only. Do not add credentials.
POWERCONTEXT_EVAL_ROOT=/data/powercontext-eval
POWERCONTEXT_EVAL_HOST=100.88.99.11
POWERCONTEXT_EVAL_PORT=8787
POWERCONTEXT_EVAL_DATABASE_PATH=/data/powercontext-eval/web/tasks.sqlite3
POWERCONTEXT_EVAL_RUN_ROOT=/data/powercontext-eval
POWERCONTEXT_EVAL_POWERCONTEXT_SOURCE=/data/powercontext-eval/source/powercontext.git
POWERCONTEXT_EVAL_HARNESS_ROOT=/data/powercontext-eval/cache/swebench-pro.git
POWERCONTEXT_EVAL_HARNESS_PYTHON=/data/powercontext-eval/venvs/swebench-pro-ca10a60/bin/python
POWERCONTEXT_EVAL_DATASET_PATH=/data/powercontext-eval/cache/swebench-pro.git/helper_code/sweap_eval_full_v2.jsonl
POWERCONTEXT_EVAL_CODEX_BINARY=/data/powercontext-eval/bin/codex
POWERCONTEXT_EVAL_CODEX_MODELS=gpt-5.6-sol
POWERCONTEXT_EVAL_CODEX_TIMEOUT_SECONDS=3600
# API-key mode uses three additional protected settings: POWERCONTEXT_EVAL_CODEX_AUTH_MODE,
# POWERCONTEXT_EVAL_CODEX_API_KEY, and POWERCONTEXT_EVAL_CODEX_OPENAI_BASE_URL. Add them only to the
# installed mode-0600 environment file; keep ordinary OPENAI_* values dedicated to PowerContext.
POWERCONTEXT_EVAL_TOKENSFLOW_BINARY=/usr/local/bin/tokensflow
POWERCONTEXT_EVAL_TOKENSFLOW_USER_HOME=/home/evaluation-operator
POWERCONTEXT_EVAL_TOKENSFLOW_EGRESS_NETWORK=bridge
POWERCONTEXT_EVAL_TOKENSFLOW_FINALIZER_TIMEOUT_SECONDS=600
POWERCONTEXT_EVAL_TOKENSFLOW_FINALIZER_POLL_SECONDS=5
POWERCONTEXT_EVAL_UV_BINARY=/data/powercontext-eval/bin/uv
POWERCONTEXT_EVAL_REGISTRY_BINARY=/data/powercontext-eval/bin/regctl
POWERCONTEXT_EVAL_AUTH_JSON=/data/powercontext-eval/codex-home/auth.json
POWERCONTEXT_EVAL_PROXY_URL=http://127.0.0.1:7890
POWERCONTEXT_EVAL_FRONTEND_DIST=/data/powercontext-eval/deploy/powercontext/evaluation/web/dist
POWERCONTEXT_EVAL_LEASE_SECONDS=60
POWERCONTEXT_EVAL_POLL_SECONDS=1
POWERCONTEXT_EVAL_USAGE_PAUSE_PERCENT=80
POWERCONTEXT_EVAL_USAGE_PROBE_SECONDS=60
POWERCONTEXT_EVAL_USAGE_PROBE_TIMEOUT_SECONDS=15
POWERCONTEXT_EVAL_USAGE_SNAPSHOT_MAX_AGE_SECONDS=120
POWERCONTEXT_EVAL_TASK_PARALLELISM=1
POWERCONTEXT_EVAL_CODEX_CAPACITY_RETRY_MAX=5

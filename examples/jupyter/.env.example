# Copy to examples/jupyter/.env, then fill in values for your own compatible provider.
# Keep credentials out of notebook cells and outputs.
# Optional: use an existing dedicated OceanBase MySQL-mode test database for tutorial Servers (lesson 15 needs its own database).
# Explicitly setting this switches storage; SERVER_DATABASE_URL is not inherited.
# POWERCONTEXT_NOTEBOOK_OCEANBASE_URL=mysql+aoceanbase://user:encoded-password@host:2881/powercontext_notebooks
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_BASE_URL=https://your-provider.example/v1

# Lessons 08, 09, 15-17, 21-22: real extraction, candidate generation, feedback, and rerank.
POWERCONTEXT_SERVER_INFERENCE_GENERATION_MODEL=openai-chat:your-chat-model
POWERCONTEXT_SERVER_INFERENCE_GENERATION_TIMEOUT_SECONDS=120

# Lesson 09: the dimension MUST match your selected embedding model.
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_MODEL=openai:your-embedding-model
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_PROFILE_ID=tutorial-embedding-v1
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_DIMENSION=1024
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_NORMALIZATION=unit
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_TIMEOUT_SECONDS=90

# Lessons 10, 16, 19, 21-22: an OpenAI-compatible chat model with tool calling.
POWERCONTEXT_NOTEBOOK_CHAT_MODEL=your-chat-model

# Lesson 11: connect to a separately running PowerContext Server (no model needed).
POWERCONTEXT_CLIENT_SERVER_URL=http://127.0.0.1:8000
# POWERCONTEXT_CLIENT_API_TOKEN=your-server-token

# Optional: use an existing Chromium instead of Playwright-managed installation.
# POWERCONTEXT_NOTEBOOK_BROWSER_EXECUTABLE=/absolute/path/to/chrome
# Explicit temporary-database verification only (verify_oceanbase.py).
# POWERCONTEXT_NOTEBOOK_OCEANBASE_ADMIN_URL=mysql+aoceanbase://user:encoded-password@host:2881/

# Copy to examples/jupyter/.powercontext/http-oceanbase.env and set a dedicated test database.
# Pass that file to `powercontext server run --env-file` on loopback.
POWERCONTEXT_SERVER_DATABASE_KIND=oceanbase
POWERCONTEXT_SERVER_DATABASE_URL=mysql+aoceanbase://user:encoded-password@host:2881/powercontext_notebooks
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_MCP_ENABLED=false
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false
POWERCONTEXT_SERVER_EXTERNAL_SKILLS='{}'

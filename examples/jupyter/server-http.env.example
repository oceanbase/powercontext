# A dedicated, model-free Server for 11_http_api_lifecycle.ipynb.
# Start with --env-file and set POWERCONTEXT_HOME as shown in the notebook.
# The explicit file replaces inherited POWERCONTEXT_SERVER_* configuration.
POWERCONTEXT_SERVER_DATABASE_KIND=sqlite
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_MCP_ENABLED=false
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false
POWERCONTEXT_SERVER_EXTERNAL_SKILLS='{}'

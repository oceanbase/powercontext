# API server configuration. Copy to .env.systemone and replace the placeholders.
# Use a complete HTTPS Chat Completions URL, not a base URL.
GENERATION_ENDPOINT=https://your-generation-provider.example/v1/chat/completions
GENERATION_MODEL=your-generation-model
GENERATION_API_KEY=

# Optional Jev reviewer. Use the credential for this specific service.
JEV_ENDPOINT=https://zenmux.ai/api/v1/systemone
JEV_MODEL=typesafe/jev-latest
JEV_API_KEY=

# Optional existing Laya reviewer; this example does not start its model server.
LAYA_ENDPOINT=http://127.0.0.1:8891/v1/systemone
LAYA_MODEL=multilingual
# May be empty if the local Laya service has no bearer authentication.
LAYA_API_KEY=
# Absolute path to the checkpoint actually served, containing tokenizer/ and
# rl_agent_config.json. Leave empty if you are not using Laya.
LAYA_CHECKPOINT=

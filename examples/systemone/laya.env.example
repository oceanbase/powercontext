# Use the checkpoint served by your Laya deployment; Chinese input needs multilingual.
SYSTEMONE_PROVIDER=laya
SYSTEMONE_ENDPOINT=http://127.0.0.1:8000/v1/systemone
SYSTEMONE_MODEL=multilingual
# Set the credential for this Laya server if its bearer authentication is enabled.
SYSTEMONE_API_KEY=

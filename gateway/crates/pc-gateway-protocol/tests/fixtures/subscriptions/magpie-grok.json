      "id": "null-reasoning",
      "source_test": "TestGrokBodyDropsNullReasoningContent",
      "request": {
        "input": [
          {
            "type": "reasoning",
            "id": "rs_1",
            "summary": [],
            "content": null,
            "encrypted_content": "a+b/c="
          },
          {
            "type": "message",
            "role": "user",
            "content": "hi"
          }
        ]
      },
      "expected": {
        "input": [
          {
            "encrypted_content": "a+b/c=",
            "id": "rs_1",
            "summary": [],
            "type": "reasoning"
          },
          {
            "content": "hi",
            "role": "user",
            "type": "message"
          }
        ]
      }
    },

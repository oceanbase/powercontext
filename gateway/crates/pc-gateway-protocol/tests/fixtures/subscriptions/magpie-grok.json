    {
      "id": "agent-task",
      "source_test": "TestGrokBodyAgentMessageGoesAsUser",
      "request": {
        "input": [
          {
            "type": "agent_message",
            "author": "/root",
            "recipient": "/root/research",
            "content": [
              {
                "type": "input_text",
                "text": "Message Type: NEW_TASK\nPayload:\nresearch the failure"
              }
            ]
          }
        ]
      },
      "expected": {
        "input": [
          {
            "content": [
              {
                "text": "From /root to /root/research\n\n",
                "type": "input_text"
              },
              {
                "text": "Message Type: NEW_TASK\nPayload:\nresearch the failure",
                "type": "input_text"
              }
            ],
            "role": "user",
            "type": "message"
          }
        ]
      }
    },

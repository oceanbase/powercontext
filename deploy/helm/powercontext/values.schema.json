{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "secretKeys": {
      "type": "object",
      "properties": {
        "databaseUrl": {
          "type": "string",
          "minLength": 1
        },
        "bearerToken": {
          "type": "string",
          "minLength": 1
        },
        "cursorSigningSecret": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "patternProperties": {
        "^POWERCONTEXT_SERVER_INFERENCE_[A-Z_]+$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "startupProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "background": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "maxWorkers": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "tolerations": {
      "type": "array"
    },
    "existingSecret": {
      "type": "string"
    },
    "providerSecret": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}

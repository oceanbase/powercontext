  "statements": [
    "CREATE TABLE `pc_code_generations` (\n  `id` char(32) COLLATE utf8mb4_bin NOT NULL,\n  `binding` char(64) COLLATE utf8mb4_bin NOT NULL,\n  `content_hash` char(64) COLLATE utf8mb4_bin NOT NULL,\n  `node_count` bigint(20) NOT NULL,\n  `edge_count` bigint(20) NOT NULL,\n  `payload_bytes` bigint(20) NOT NULL,\n  PRIMARY KEY (`id`),\n  KEY `ix_code_binding` (`binding`) BLOCK_SIZE 16384 LOCAL\n) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_bin ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0",
    "CREATE TABLE `pc_code_nodes` (\n  `generation_id` char(32) COLLATE utf8mb4_bin NOT NULL,\n  `id` char(64) COLLATE utf8mb4_bin NOT NULL,\n  `kind` varchar(32) COLLATE utf8mb4_bin NOT NULL,\n  `path` text COLLATE utf8mb4_bin NOT NULL,\n  `file_id` char(64) COLLATE utf8mb4_bin DEFAULT NULL,\n  `parent_id` char(64) COLLATE utf8mb4_bin DEFAULT NULL,\n  `name` text COLLATE utf8mb4_bin NOT NULL,\n  `qualified_name` text COLLATE utf8mb4_bin NOT NULL,\n  `start_line` bigint(20) NOT NULL,\n  `end_line` bigint(20) NOT NULL,\n  `payload` longtext COLLATE utf8mb4_bin NOT NULL,\n  `searchable_text` longtext COLLATE utf8mb4_bin NOT NULL,\n  PRIMARY KEY (`generation_id`, `id`),\n  KEY `ix_code_path` (`generation_id`, `path`(190), `start_line`) BLOCK_SIZE 16384 LOCAL,\n  KEY `ix_code_name` (`generation_id`, `name`(190)) BLOCK_SIZE 16384 LOCAL,\n  KEY `ix_code_qualified` (`generation_id`, `qualified_name`(190)) BLOCK_SIZE 16384 LOCAL,\n  KEY `ix_code_parent` (`generation_id`, `parent_id`) BLOCK_SIZE 16384 LOCAL,\n  FULLTEXT KEY `ix_code_search` (`searchable_text`) WITH PARSER space PARSER_PROPERTIES=(min_token_size=3,max_token_size=84) BLOCK_SIZE 16384\n) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_bin ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0",
    "CREATE TABLE `pc_code_edges` (\n  `generation_id` char(32) COLLATE utf8mb4_bin NOT NULL,\n  `ordinal` bigint(20) NOT NULL,\n  `source_id` char(64) COLLATE utf8mb4_bin NOT NULL,\n  `target_id` char(64) COLLATE utf8mb4_bin NOT NULL,\n  `kind` varchar(32) COLLATE utf8mb4_bin NOT NULL,\n  `resolution` varchar(32) COLLATE utf8mb4_bin NOT NULL,\n  `payload` longtext COLLATE utf8mb4_bin NOT NULL,\n  PRIMARY KEY (`generation_id`, `ordinal`),\n  KEY `ix_code_source` (`generation_id`, `source_id`, `kind`) BLOCK_SIZE 16384 LOCAL,\n  KEY `ix_code_target` (`generation_id`, `target_id`, `kind`) BLOCK_SIZE 16384 LOCAL\n) ORGANIZATION INDEX DEFAULT CHARSET = utf8mb4 COLLATE = utf8mb4_bin ROW_FORMAT = DYNAMIC COMPRESSION = 'zstd_1.3.8' BLOCK_SIZE = 16384 TABLET_SIZE = 134217728 PCTFREE = 0"

{
  "format": "powercontext.mysql-state-layouts.v1",
  "revisions": {
    "v1_5_0_005": {
      "statements": [
        "CREATE TABLE pc_work_lanes (\n\tlane_key VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\thead_sequence BIGINT, \n\tnext_sequence BIGINT NOT NULL, \n\tPRIMARY KEY (lane_key), \n\tCONSTRAINT ck_pc_work_lanes_head_positive CHECK (head_sequence IS NULL OR head_sequence > 0), \n\tCONSTRAINT ck_pc_work_lanes_next_positive CHECK (next_sequence > 0)\n)",
        "CREATE TABLE pc_work_items (\n\twork_id VARCHAR(36) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tlogical_key VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tlane_key VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tlane_sequence BIGINT NOT NULL, \n\tkind VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tpayload_version INTEGER NOT NULL, \n\tscope_id VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tpayload MEDIUMBLOB NOT NULL, \n\tstatus VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tavailable_at DATETIME(6) NOT NULL, \n\tlease_owner VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\tlease_fence BIGINT NOT NULL, \n\tlease_expires_at DATETIME(6), \n\tattempt_count INTEGER NOT NULL, \n\tgeneration_attempt_count INTEGER NOT NULL, \n\trecovery_generation INTEGER NOT NULL, \n\tmax_attempts INTEGER NOT NULL, \n\tcancel_requested TINYINT(1) NOT NULL, \n\tresult_code VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\tresult_payload MEDIUMBLOB, \n\terror_category VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\terror_code VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\tstate_version BIGINT NOT NULL, \n\tcreated_at DATETIME(6) NOT NULL, \n\tupdated_at DATETIME(6) NOT NULL, \n\tcompleted_at DATETIME(6), \n\tPRIMARY KEY (work_id), \n\tCONSTRAINT uq_pc_work_items_lane_sequence UNIQUE (lane_key, lane_sequence), \n\tCONSTRAINT ck_pc_work_items_status CHECK (status IN ('queued', 'running', 'retry_wait', 'cancelling', 'succeeded', 'failed', 'cancelled')), \n\tCONSTRAINT ck_pc_work_items_lane_sequence_positive CHECK (lane_sequence > 0), \n\tCONSTRAINT ck_pc_work_items_payload_version_positive CHECK (payload_version > 0), \n\tCONSTRAINT ck_pc_work_items_fence_nonnegative CHECK (lease_fence >= 0), \n\tCONSTRAINT ck_pc_work_items_attempts_nonnegative CHECK (attempt_count >= 0), \n\tCONSTRAINT ck_pc_work_items_generation_attempts_nonnegative CHECK (generation_attempt_count >= 0), \n\tCONSTRAINT ck_pc_work_items_recovery_nonnegative CHECK (recovery_generation >= 0), \n\tCONSTRAINT ck_pc_work_items_max_attempts_positive CHECK (max_attempts > 0), \n\tCONSTRAINT ck_pc_work_items_state_version_positive CHECK (state_version > 0),\n\tKEY ix_pc_work_items_claim (status, available_at),\n\tKEY ix_pc_work_items_completed (completed_at),\n\tKEY ix_pc_work_items_lane_status (lane_key, status),\n\tKEY ix_pc_work_items_scope_created (scope_id, created_at)\n)",
        "CREATE TABLE pc_work_keys (\n\tlogical_key VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\twork_id VARCHAR(36) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tlane_key VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tcreated_at DATETIME(6) NOT NULL, \n\tPRIMARY KEY (logical_key), \n\tCONSTRAINT uq_pc_work_keys_work_id UNIQUE (work_id)\n)",
        "CREATE TABLE pc_work_attempts (\n\twork_id VARCHAR(36) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tattempt_no INTEGER NOT NULL, \n\trecovery_generation INTEGER NOT NULL, \n\towner_id VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tfence BIGINT NOT NULL, \n\tstarted_at DATETIME(6) NOT NULL, \n\theartbeat_at DATETIME(6) NOT NULL, \n\tfinished_at DATETIME(6), \n\toutcome VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\terror_category VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\terror_code VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\ttrace_id VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\tspan_id VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\tPRIMARY KEY (work_id, attempt_no), \n\tCONSTRAINT ck_pc_work_attempts_attempt_positive CHECK (attempt_no > 0), \n\tCONSTRAINT ck_pc_work_attempts_recovery_nonnegative CHECK (recovery_generation >= 0), \n\tCONSTRAINT ck_pc_work_attempts_fence_positive CHECK (fence > 0),\n\tKEY ix_pc_work_attempts_finished (finished_at)\n)",
        "CREATE TABLE pc_scheduler_leases (\n\tlease_name VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\towner_id VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\tfence BIGINT NOT NULL, \n\tlease_expires_at DATETIME(6), \n\tupdated_at DATETIME(6) NOT NULL, \n\tPRIMARY KEY (lease_name), \n\tCONSTRAINT ck_pc_scheduler_leases_fence_nonnegative CHECK (fence >= 0)\n)",
        "CREATE TABLE pc_scheduler_scans (\n\tdiscoverer VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tnext_run_at DATETIME(6) NOT NULL, \n\tcontinuation VARCHAR(256) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, \n\tstate_version BIGINT NOT NULL, \n\tupdated_at DATETIME(6) NOT NULL, \n\tPRIMARY KEY (discoverer), \n\tCONSTRAINT ck_pc_scheduler_scans_version_positive CHECK (state_version > 0)\n)",
        "CREATE TABLE pc_runtime_members (\n\tmember_id VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\t`role` VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tbuild_version VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tschema_min INTEGER NOT NULL, \n\tschema_max INTEGER NOT NULL, \n\tpayload_min INTEGER NOT NULL, \n\tpayload_max INTEGER NOT NULL, \n\tbehavior_revision VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\theartbeat_at DATETIME(6) NOT NULL, \n\texpires_at DATETIME(6) NOT NULL, \n\tPRIMARY KEY (member_id), \n\tCONSTRAINT ck_pc_runtime_members_role CHECK (role IN ('all', 'api', 'scheduler', 'worker')), \n\tCONSTRAINT ck_pc_runtime_members_schema_range CHECK (schema_min > 0 AND schema_max >= schema_min), \n\tCONSTRAINT ck_pc_runtime_members_payload_range CHECK (payload_min > 0 AND payload_max >= payload_min),\n\tKEY ix_pc_runtime_members_role_expiry (`role`, expires_at)\n)",
        "CREATE TABLE pc_rate_limit_windows (\n\tprincipal_key VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\tpolicy_id VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL, \n\twindow_started_at DATETIME(6) NOT NULL, \n\trequest_count BIGINT NOT NULL, \n\texpires_at DATETIME(6) NOT NULL, \n\tPRIMARY KEY (principal_key, policy_id, window_started_at), \n\tCONSTRAINT ck_pc_rate_limit_windows_count_positive CHECK (request_count > 0),\n\tKEY ix_pc_rate_limit_windows_expiry (expires_at)\n)"
      ],

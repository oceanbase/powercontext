{
  "name": "powercontext-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate && next dev",
    "build": "pnpm generate && next build && pnpm verify:export",
    "generate": "tsx scripts/generate-content.ts",

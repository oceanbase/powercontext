    "fumadocs-mdx": "15.4.0",
    "fumadocs-openapi": "11.3.5",
    "fumadocs-python": "1.0.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.4",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxlint": "1.80.0",
    "postcss": "8.5.23",
    "serve": "14.2.6",
    "shiki": "4.4.0",
    "tailwindcss": "4.3.3",
